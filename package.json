{
  "name": "@gronbergtech/kundebox-sikker-kjerne",
  "version": "0.1.0",
  "private": true,
  "description": "Delt innloggings- og sikkerhetskjerne for Kundebox-produkter (passordhash, sesjon, rate-limit). Skrives én gang, brukes i flere produkter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "optionalDependencies": {
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
